<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mathtutor.controller.SettingsController"
            style="-fx-padding: 20;"
            stylesheets="@/settings.css">

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" style=" -fx-font-size: 20;">

            <!-- Вкладка Telegram-бот -->
            <Tab text="Telegram-бот" styleClass="tab-item">
                <VBox spacing="15" style="-fx-padding: 20;  -fx-font-size: 20;">
                    <Label text="Токен Telegram-бота:"/>
                    <TextField fx:id="botTokenField" promptText="Введите токен бота"/>
                    <Button fx:id="checkConnectionButton" text="Проверить подключение"/>
                    <Label fx:id="connectionStatusLabel" text="Статус: не подключено" />
                </VBox>
            </Tab>

            <!-- Вкладка Платёжные данные -->
            <Tab text="Платёжные данные" styleClass="tab-item">
                <StackPane fx:id="cardPane" style="-fx-padding: 40; -fx-background-color: linear-gradient(to right, #FFE6B3, #FFA500);">
                    <VBox fx:id="cardBox"
                          spacing="20"
                          alignment="CENTER"
                          style="-fx-background-color: rgba(255, 255, 255, 0.15);
                                 -fx-background-radius: 20;
                                 -fx-border-color: rgba(255, 255, 255, 0.2);
                                 -fx-border-radius: 20;
                                 -fx-padding: 30;
                                 -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.3), 15, 0.5, 0, 0);
                                 -fx-opacity: 1;
                                 -fx-scale-x: 1.0;
                                 -fx-scale-y: 1.0;">
                        <!-- Логотип карты -->
                        <Label text="Обновление платежных данных" style="-fx-text-fill: black; -fx-font-size: 24; -fx-font-weight: bold;"/>

                        <!-- Номер карты -->
                        <HBox spacing="10" alignment="CENTER">
                            <TextField fx:id="num1" promptText="0000" style="-fx-max-width: 100; -fx-font-family: monospace; -fx-font-size: 20;"/>
                            <TextField fx:id="num2" promptText="0000" style="-fx-max-width: 100; -fx-font-family: monospace; -fx-font-size: 20;"/>
                            <TextField fx:id="num3" promptText="0000" style="-fx-max-width: 100; -fx-font-family: monospace; -fx-font-size: 20;"/>
                            <TextField fx:id="num4" promptText="0000" style="-fx-max-width: 100; -fx-font-family: monospace; -fx-font-size: 20;"/>
                        </HBox>

                        <!-- Имя владельца -->
                        <TextField fx:id="cardHolderField"
                                   promptText="Введите имя владельца"
                                   style="-fx-font-size: 20; -fx-font-family: sans-serif; -fx-background-radius: 10;"/>

                        <!-- Кнопка -->
                        <Button fx:id="savePaymentInfoButton" text="Сохранить"
                                style="-fx-background-color: #FE8200;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-font-size: 20;"/>

                        <Label fx:id="saveStatusLabel" text="" style="-fx-text-fill: white;"/>
                    </VBox>
                </StackPane>
            </Tab>

            <!-- Вкладка График работы -->
            <Tab text="График работы" styleClass="tab-item">
                <VBox spacing="15" style="-fx-padding: 20;  -fx-font-size: 20;">
                    <Label text="Выберите рабочие дни и время:"/>
                    <CheckBox text="Понедельник"/>
                    <CheckBox text="Вторник"/>
                    <CheckBox text="Среда"/>
                    <CheckBox text="Четверг"/>
                    <CheckBox text="Пятница"/>
                    <CheckBox text="Суббота"/>
                    <CheckBox text="Воскресенье"/>
                    <Label text="Часы работы:"/>
                    <HBox spacing="10">
                        <TextField fx:id="startTimeField" promptText="с (например, 10:00)" />
                        <TextField fx:id="endTimeField" promptText="до (например, 18:00)" />
                    </HBox>
                    <Button text="Сохранить график"/>
                </VBox>
            </Tab>

            <!-- Вкладка Уведомления -->
            <Tab text="Уведомления" styleClass="tab-item">
                <VBox spacing="15" style="-fx-padding: 20;  -fx-font-size: 20;">
                    <CheckBox fx:id="enableRemindersCheckBox" text="Напоминать перед занятием"/>
                    <CheckBox fx:id="enablePaymentAlertsCheckBox" text="Уведомлять об оплате"/>
                    <CheckBox fx:id="enableSoundCheckBox" text="Включить звуковые уведомления"/>
                    <Button text="Сохранить настройки уведомлений"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
